  id: F55_S02
  zukanTitle: "\u6700\u8FD1\u306E\u5E83\u544A\u9577\u3059\u304E\u3060\u3088\u306A"
  floor: 55
  step: 2
  backgroundImage: {fileID: 21300000, guid: aef2ec3c256f226419898fc53b2fda28, type: 3}
  lines:
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u6700\u8FD1\u306F\u5E73\u6C17\u30671\u3064\u306E\u5E83\u544A\u30673\u3064\u306E\u30A2\u30D7\u30EA\u3092\u6D41\u3057\u305F\u308A\u3059\u308B\u3088\u306A\u2026\u2026\n\u81EA\u52D5\u3067\u5207\u308A\u66FF\u308F\u3089\u305A\u306B\u3001\u3044\u3061\u3044\u3061\xD7\u30DC\u30BF\u30F3\u3068\u304B\u62BC\u3059\u5FC5\u8981\u304C\u3042\u3063\u305F\u308A\u3002"
    portrait: {fileID: -1474213477433997886, guid: 9a865c02e1edaa349aa9835276d7453f, type: 3}
    backgroundOverride: {fileID: 0}
    requestNameInput: 0
  - speaker: You
    text: "\u5E83\u544A\u30D3\u30B8\u30CD\u30B9\u30E2\u30C7\u30EB\u306F\u9650\u754C\u304C\u6765\u3066\u308B\u304B\u3089\u3001\n\u305D\u306E\u5206\u3069\u3053\u3082\u6570\u3092\u5897\u3084\u3059\u3057\u304B\u7121\u3044\u3093\u3060\u308D\u3046\u306A\u2026\u2026"
    portrait: {fileID: -1474213477433997886, guid: 9a865c02e1edaa349aa9835276d7453f, type: 3}
    backgroundOverride: {fileID: 0}
    requestNameInput: 0
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u305B\u3081\u3066\u7686\u306B\u306F\u5E83\u544A\u3067\u5ACC\u306A\u60F3\u3044\u3057\u3066\u6B32\u3057\u304F\u7121\u3044\u304B\u3089\u3001\n\u3053\u306E\u30B2\u30FC\u30E0\u306E\u5E83\u544A\u306F\u5B8C\u6210\u3059\u308C\u3070\u30B9\u30AD\u30C3\u30D7\u53EF\u80FD\u306A\u3001\n\u30B8\u30B0\u30BD\u30FC\u30D1\u30BA\u30EB\u5F62\u5F0F\u306B\u3059\u308B\u3064\u3082\u308A\u3060\u305C\u3002\u795E\u30B2\u30FC\u3060\u308D\u3046\uFF1F"
    portrait: {fileID: -3833558156305714257, guid: d0a1416310d325447b2072d177408040, type: 3}
    backgroundOverride: {fileID: 0}
    requestNameInput: 0
  consoleLines:
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "Steam\u306B\u30B2\u30FC\u30E0\u3092\u51FA\u3059\u6642\u306F\u3001\n1\u672C\u306B\u3064\u304D100\u30C9\u30EB\u5FC5\u8981\u306A\u3093\u3060\u3002\n\u307E\u3041\u7121\u6599\u3060\u3068\u30AF\u30BD\u30B2\u30FC\u3060\u3089\u3051\u306B\u306A\u308B\u3057\u306A\u3002"
    portrait: {fileID: -5075695696183938511, guid: 0a890b709db3960428ff418f7aeebe9a, type: 3}
    backgroundOverride: {fileID: 0}
    requestNameInput: 0
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u305D\u3057\u3066Switch\u3067\u30B2\u30FC\u30E0\u3092\u51FA\u3059\u6642\u306F\u3001\n\u5C02\u7528\u306E\u958B\u767A\u30AD\u30C3\u30C8\u306B10\u4E07\u5186\u5FC5\u8981\u306A\u3093\u3060\u3002"
    portrait: {fileID: -6269266055418861456, guid: 50b50e7433fb4b940a7c93223d3f9f5d, type: 3}
    backgroundOverride: {fileID: 0}
    requestNameInput: 0
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u30BB\u30FC\u30EB\u3068\u304B\u3067\u305F\u307E\u306B\u898B\u304B\u3051\u308B\u3001\n\u8B0E\u306EAI\u30A4\u30E9\u30B9\u30C8\u306E\u7F8E\u5C11\u5973\u304C\u51FA\u3066\u6765\u308B\n\u8A33\u306E\u5206\u304B\u3089\u306A\u3044\u30B2\u30FC\u30E0\u3092\u4F5C\u3063\u3066\u308B\u4EBA\u3082\u3001"
    portrait: {fileID: -1474213477433997886, guid: 9a865c02e1edaa349aa9835276d7453f, type: 3}
    backgroundOverride: {fileID: 0}
    requestNameInput: 0
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u304D\u3061\u3093\u3068\u4F1A\u793E\u3068\u3057\u3066\u4EFB\u5929\u5802\u306E\u8A31\u53EF\u3092\u53D7\u3051\u3066\u3001\n\u9AD8\u3044\u958B\u767A\u30AD\u30C3\u30C8\u8CB7\u3063\u3066\u958B\u767A\u3057\u3066\u308B\u3068\u601D\u3046\u3068\u3001\n\u611F\u6168\u6DF1\u3044\u306A\u2026"
    portrait: {fileID: -1474213477433997886, guid: 9a865c02e1edaa349aa9835276d7453f, type: 3}
    backgroundOverride: {fileID: 0}
    requestNameInput: 0
  consoleZukanTitle: "\u30B3\u30F3\u30BD\u30FC\u30EB\u306B\u306F\u304A\u91D1\u304C\u304B\u304B\u308B"
