  lines:
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "80\u5C64\u306E\u4E2D\u6575\u30BE\u30A6\u30F3\u306F\u3001\n\u52D5\u7269\u5712\u306E\u4EBA\u6C17\u8005\u3001\u8C61\u30BE\u30A6\u30F3\u3060\uFF01"
    portrait: {fileID: -9110550355602550490, guid: 1c9a759beefc7a545b788047293b1cf3, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u307E\u305A\u306F\u30AE\u30EA\u30E1\u30AB\u30E9\u3002\n\u7269\u7406\u53CD\u5C04\uFF1F\u3000\u4F55\u306E\u8A71\u3060\u3088\u3001\u305D\u3093\u306A\u30B7\u30B9\u30C6\u30E0\u7121\u3044\u305C\u3002\n\u7269\u7406\u9632\u5FA1\u306F600\u3082\u3042\u308B\u3051\u3069\u306A\u3002"
    portrait: {fileID: -9110550355602550490, guid: 1c9a759beefc7a545b788047293b1cf3, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u6B21\u306F\u30A2\u30A4\u30E9\u30FC\u30F4\u30A1\u30BF\u3060\u3002\u8056\u306A\u308B\u30BE\u30A6\u3055\u3093\u3067\u3001\n\u3053\u3063\u3061\u306F\u9B54\u6CD5\u9632\u5FA1\u304C\u304B\u306A\u308A\u9AD8\u3044\u30BE\u30A6\u3002"
    portrait: {fileID: -9110550355602550490, guid: 1c9a759beefc7a545b788047293b1cf3, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u6700\u5F8C\u306F\u30AC\u30CD\u30FC\u30B7\u30E3\u3002\u5927\u62B5\u30AB\u30E1\u30E9\u76EE\u7DDA\u3067\u3042\u3050\u3089\u3068\u304B\u63BB\u3044\u3066\u308B\u3088\u306A\u3002\n\u672C\u5F53\u306B\u8C61\u306A\u306E\u304B\u602A\u3057\u304F\u306A\u3063\u3066\u304F\u308B\u306A\u3002"
    portrait: {fileID: -9110550355602550490, guid: 1c9a759beefc7a545b788047293b1cf3, type: 3}
