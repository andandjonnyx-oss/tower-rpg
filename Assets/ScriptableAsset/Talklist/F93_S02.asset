  id: F93_S02
  zukanTitle: "3\u3064\u306E\u5854"
  floor: 93
  step: 2
  backgroundImage: {fileID: 21300000, guid: aef2ec3c256f226419898fc53b2fda28, type: 3}
  lines:
  - speaker: You
    text: "\u3053\u3053\u307F\u305F\u3044\u306A\u5854\u306F\u3001\u4ED6\u306B\u3082\u3042\u308B\u306E\u304B\uFF1F"
    portrait: {fileID: -5075695696183938511, guid: 0a890b709db3960428ff418f7aeebe9a, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u304A\u3044\u304A\u3044\u3001\u79C1\u3068\u306E\u5192\u967A\u306E\u9014\u4E2D\u306B\u6B21\u306E\u5192\u967A\u306E\u8A71\u304B\u3088\u3002\n\u9177\u3044\u7537\u3060\u306A\u2026\u2026"
    portrait: {fileID: -8468336318900812975, guid: a71047c7cdbc5ef48950b42866cc45b3, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u3069\u3046\u3082\u3053\u306E\u5854\u3092\u4F5C\u3063\u305F\u3001\u3044\u308F\u3070\u79C1\u306E\u89AA\u307F\u305F\u3044\u306A\u5B58\u5728\u306F\u3001\n\u3053\u306E\u5854\u3092\u4F5C\u3063\u305F\u5F8C\u306B\u5225\u306E\u5834\u6240\u30672\u3064\u5854\u3092\u4F5C\u3063\u305F\u3089\u3057\u3044\u3093\u3060\u3088\u306A\u3002"
    portrait: {fileID: -5075695696183938511, guid: 0a890b709db3960428ff418f7aeebe9a, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u305D\u3053\u306B\u3082\u79C1\u307F\u305F\u3044\u306A\u5B88\u8B77\u8005\u304C\u3044\u3066\u3001\n\u4E00\u4F5C\u76EE\u2026\u2026\u8A66\u4F5C\u54C1\u306E\u79C1\u3088\u308A\u3082\u9065\u304B\u306B\u5F37\u3044\u3089\u3057\u3044\u3002\n\u3044\u308F\u3070\u79C1\u306F\u4E09\u59C9\u59B9\u306E\u672B\u3063\u5B50\u3063\u3066\u3068\u3053\u3060\u306A\u3002"
    portrait: {fileID: -5075695696183938511, guid: 0a890b709db3960428ff418f7aeebe9a, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: You
    text: "\u2026\u2026\u3044\u3084\u3001\u5148\u306B\u4F5C\u3089\u308C\u305F\u3093\u306A\u3089\u304A\u524D\u304C\u59C9\u3060\u308D\u3002"
    portrait: {fileID: -5075695696183938511, guid: 0a890b709db3960428ff418f7aeebe9a, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u78BA\u304B\u306B\u2026\u2026\n\u79C1\u3082\u9060\u898B\u306E\u9B54\u6CD5\u3068\u304B\u3067\u305D\u306E\u5854\u3092\u63A2\u3057\u3066\u308B\u3093\u3060\u3051\u3069\u3001\n\u898B\u3064\u304B\u3089\u306A\u3044\u3093\u3060\u3088\u306A\u3002\u672C\u5F53\u306B\u3042\u308B\u306E\u304B\u306A\u3041\u2026\u2026"
    portrait: {fileID: -6269266055418861456, guid: 50b50e7433fb4b940a7c93223d3f9f5d, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u3042\u3042\u3001\u30D7\u30EC\u30A4\u30E4\u30FC\u306F\u308F\u304B\u3063\u3066\u308B\u3068\u601D\u3046\u3051\u3069\u3001\n\u6B21\u56DE\u4F5C\u5019\u88DC\u306E\u8A71\u3060\u305C\u3002\n\u5B8C\u6210\u3059\u308B\u3068\u3044\u3044\u306A\uFF01"
    portrait: {fileID: -3833558156305714257, guid: d0a1416310d325447b2072d177408040, type: 3}
    backgroundOverride: {fileID: 0}
