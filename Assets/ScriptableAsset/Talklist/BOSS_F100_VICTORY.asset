    backgroundOverride: {fileID: 0}
    requestNameInput: 0
  - speaker: '-'
    text: "\u30D5\u30A7\u30B4\u30FC\u30EB\u304C\u6D88\u3048\u308B\u3068\u540C\u6642\u306B\u3001\n\u8CB4\u65B9\u306E\u4E2D\u306B\u81A8\u5927\u306A\u30D1\u30EF\u30FC\u304C\u306A\u3060\u308C\u8FBC\u3093\u3067\u6765\u308B\u3002\n\u8CB4\u65B9\u306F\u7A7A\u306B\u624B\u3092\u4F38\u3070\u3057\u3001\u9858\u3044\u3092\u53E3\u306B\u3059\u308B\u3002"
