    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u307E\u3041\u306A\u2026\u2026\u4F1A\u8A71\u30A4\u30D9\u30F3\u30C8\u306E\u6642\u3060\u3051\u7A81\u7136\u30EF\u30FC\u30D7\u3057\u3066\n\u4F1A\u8A71\u304C\u7D42\u308F\u3063\u305F\u3089\u6D88\u3048\u308B\u306E\u306F\u30D2\u30ED\u30A4\u30F3\u3068\u3057\u3066\u5473\u6C17\u306A\u3044\u304B\u3089\u306A\u3002\n\u5B9F\u969B\u306B\u306F\u30D7\u30EC\u30A4\u30E4\u30FC\u306E\u898B\u3048\u306A\u3044\u3068\u3053\u308D\u3067\u611B\u3068\u304B\u53CB\u60C5\u3092\u80B2\u3093\u3067\u305F\u3093\u3060\u305C\uFF1F\n\u305D\u306E\u5168\u90E8\u3092\u898B\u305B\u3089\u308C\u306A\u304F\u3066\u7533\u3057\u8A33\u306A\u3044\u3068\u601D\u3063\u3066\u3044\u308B\u3088\u2026\u2026"
