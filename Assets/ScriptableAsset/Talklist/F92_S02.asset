  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u3064\u3044\u30CE\u30EA\u3067\u9802\u4E0A\u3067\u4F1A\u304A\u3046\u3068\u304B\u8A00\u3063\u3061\u3083\u3063\u305F\u3051\u3069\u3001\n\u4F1A\u8A71\u30A4\u30D9\u30F3\u30C8\u306E\u305F\u3081\u306B\u623B\u3063\u3066\u6765\u305F\u305C\uFF01"
