  lines:
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u3053\u306A\u3044\u3060\u3055\u3001\u30AE\u30EA\u30E1\u30AB\u30E9\u3068\u30A2\u30A4\u30E9\u30FC\u30F4\u30A1\u30BF\u3068\u30AC\u30CD\u30FC\u30B7\u30E3\u3068\u3001\n\u9EBB\u96C0\u6253\u3063\u305F\u3093\u3060\u3051\u3069\u3055\u3002"
    portrait: {fileID: -5075695696183938511, guid: 0a890b709db3960428ff418f7aeebe9a, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: You
    text: "\u3069\u3053\u304B\u3089\u7A81\u3063\u8FBC\u3081\u3070\u3044\u3044\u3093\u3060\u2026\u2026"
    portrait: {fileID: -9110550355602550490, guid: 1c9a759beefc7a545b788047293b1cf3, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u300C\u304A\u3044\u3001\u3053\u308C\u8C61\u7259\u306E\u9EBB\u96C0\u724C\u3058\u3083\u306D\u3048\u304B\uFF01\u300D\u300C\u99AC\u9E7F\u306B\u3057\u3066\u3093\u306E\u304B\uFF01\u300D\n\u300C\u3082\u3046\u6012\u3063\u305F\u30BE\u30A6\uFF01\u300D\u3063\u3066\u5927\u8352\u308C\u306B\u306A\u3063\u3061\u307E\u3063\u3066\u3002"
    portrait: {fileID: -9110550355602550490, guid: 1c9a759beefc7a545b788047293b1cf3, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u6D41\u77F3\u306B\u79C1\u3082\u7D0D\u5F97\u51FA\u6765\u306A\u304F\u3066\u53CD\u8AD6\u3057\u305F\u306D\u3002\n\u300C\u78BA\u304B\u306B\u53C2\u8003\u306B\u306F\u3057\u305F\u3051\u3069\u3001\u79C1\u306E\u9B54\u529B\u3067\u4F5C\u3063\u305F\u3093\u3060\u304B\u3089\u8C61\u7259\u3058\u3083\u7121\u3044\u3060\u308D\u300D\u3063\u3066\u3002\n\u3069\u3046\u601D\u3046\uFF1F"
    portrait: {fileID: -9110550355602550490, guid: 1c9a759beefc7a545b788047293b1cf3, type: 3}
    backgroundOverride: {fileID: 0}
