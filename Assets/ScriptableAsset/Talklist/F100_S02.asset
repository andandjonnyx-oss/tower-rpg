  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u3055\u3057\u305A\u3081\u79C1\u306E\u60AA\u306E\u5FC3\u304C\u5206\u96E2\u3057\u3066\u5177\u73FE\u5316\u3057\u305F\u3063\u3066\u3068\u3053\u3060\u306A\u2026\u2026\n\u3060\u304B\u3089\u3063\u3066\u95C7\u653B\u6483\u3057\u304B\u4F7F\u3063\u3066\u3053\u306A\u3044\u3068\u304B\u3001\n\u305D\u3093\u306A\u4E8B\u306F\u7121\u3044\u3051\u3069\u306A\u3002"
