  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u307B\u3089\u3001\u3088\u304F\u3044\u308B\u3060\u308D\uFF1F\n\u88CF\u30DC\u30B9\u7684\u306A\u611F\u3058\u3067\u3001\u30E9\u30B9\u30DC\u30B9\u306E\u30DE\u30A4\u30CA\u30FC\u30C1\u30A7\u30F3\u30B8\u7248\u304C\u51FA\u3066\u6765\u308B\u306E\u3002\n\u3042\u308C\u304C\u3084\u308A\u305F\u304B\u3063\u305F\u3093\u3060\u3088\u3002"
