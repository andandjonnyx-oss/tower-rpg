    text: "\u3064\u3044\u306B100\u968E\uFF01\n\u6700\u5F8C\u306E\u30EC\u30A2\u30E2\u30F3\u30B9\u30BF\u30FC\u306F\u3001\u30B7\u30E3\u30C9\u30A6\u30D5\u30A7\u30B4\u30FC\u30EB\uFF01"
