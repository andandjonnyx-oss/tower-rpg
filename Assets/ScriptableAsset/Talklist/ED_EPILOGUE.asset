  backgroundImage: {fileID: 21300000, guid: d620cb937c4e4b9448fc338c758a9fc7, type: 3}
  lines:
  - speaker: '-'
    text: "\u8CB4\u65B9\u304C\u76EE\u3092\u899A\u307E\u3057\u305F\u6642\u3001\u305D\u3053\u306F\u62E0\u70B9\u3068\u3057\u3066\u501F\u308A\u3066\u3044\u308B\u5BBF\u5C4B\u3060\u3063\u305F\u3002\n\u7A93\u306E\u5916\u304B\u3089\u5854\u3092\u63A2\u3059\u304C\u3001\u307E\u308B\u3067\u6700\u521D\u304B\u3089\u4F55\u3082\u7121\u304B\u3063\u305F\u304B\u306E\u3088\u3046\u306B\n\u5854\u306E\u59FF\u306F\u6D88\u3048\u3066\u3044\u308B\u3002"
    portrait: {fileID: 0}
    backgroundOverride: {fileID: 21300000, guid: 341c2002a635e9a41ae9eb4b97152ef7, type: 3}
    requestNameInput: 0
  - speaker: '-'
    text: "\u8CB4\u65B9\u306F\u5009\u5EAB\u306B\u5411\u304B\u3044\u3001\u4E00\u5339\u3060\u3051\u6B8B\u3063\u3066\u3044\u305F\u732B\u3092\u3064\u307E\u307F\u8857\u306E\u4E2D\u306B\u653E\u3059\u3002\n\u305D\u3057\u3066\u8CB4\u65B9\u306F\u8857\u3092\u53BB\u3063\u3066\u3044\u304F\u3002\u6B21\u306E\u65C5\u304C\u5F85\u3063\u3066\u3044\u308B\u306E\u3060\u3002"
    portrait: {fileID: 0}
    backgroundOverride: {fileID: 21300000, guid: f6c40fdda95f91e4a955bbef6b8d5bee, type: 3}
    requestNameInput: 0
  - speaker: You
    text: "\u2026\u2026\u3058\u3083\u3042\u306A\u3002"
    portrait: {fileID: 0}
    backgroundOverride: {fileID: 21300000, guid: d620cb937c4e4b9448fc338c758a9fc7, type: 3}
    requestNameInput: 0
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u305D\u308C\u3067\u3001\u6B21\u306F\u3069\u3053\u306B\u884C\u304F\u3093\u3060\uFF1F\n\u30AA\u30B9\u30B9\u30E1\u306F\u30B8\u30D1\u30F3\u30B0\u3060\u306A\uFF01\n\u672C\u5834\u306E18\u30A2\u30A4\u30B9\u3092\u98DF\u3079\u306B\u884C\u3053\u3046\uFF01"
    portrait: {fileID: -5075695696183938511, guid: 0a890b709db3960428ff418f7aeebe9a, type: 3}
    backgroundOverride: {fileID: 0}
    requestNameInput: 0
  - speaker: You
    text: "\u2026\u2026\u4F55\u3067\u304A\u524D\u304C\u3053\u3053\u306B\u3044\u308B\u3093\u3060\u3002"
    portrait: {fileID: -5075695696183938511, guid: 0a890b709db3960428ff418f7aeebe9a, type: 3}
    backgroundOverride: {fileID: 0}
    requestNameInput: 0
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u8A00\u308F\u305B\u3093\u306A\u3088\u3002\n\u300E\u79C1\u3068\u4E00\u7DD2\u306B\u65C5\u304C\u3057\u305F\u3044\u300F\n\u3063\u3066\u304A\u524D\u304C\u9858\u3063\u305F\u304B\u3089\u3060\u308D\uFF1F"
    portrait: {fileID: -3833558156305714257, guid: d0a1416310d325447b2072d177408040, type: 3}
    backgroundOverride: {fileID: 0}
    requestNameInput: 0
  - speaker: You
    text: "\u305D\u3093\u306A\u9858\u3044\u3092\u3057\u305F\u899A\u3048\u306F\u306A\u3044\u3002"
    portrait: {fileID: -3833558156305714257, guid: d0a1416310d325447b2072d177408040, type: 3}
    backgroundOverride: {fileID: 0}
    requestNameInput: 0
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u7167\u308C\u3093\u306A\u7167\u308C\u3093\u306A\u3002\n\u2026\u2026\u305D\u3046\u3044\u3048\u3070\u3001\u304A\u524D\u306E\u540D\u524D\u3092\u307E\u3060\u805E\u3044\u3066\u306A\u304B\u3063\u305F\u3088\u306A\u3002\u306A\u3093\u3066\u8A00\u3046\u3093\u3060\uFF1F"
    portrait: {fileID: -3833558156305714257, guid: d0a1416310d325447b2072d177408040, type: 3}
    backgroundOverride: {fileID: 0}
    requestNameInput: 0
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "{name}\u304B\u3002\u3044\u3044\u540D\u524D\u3060\u306A\u3002"
    portrait: {fileID: -5075695696183938511, guid: 0a890b709db3960428ff418f7aeebe9a, type: 3}
    backgroundOverride: {fileID: 0}
    requestNameInput: 1
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u3068\u306B\u304B\u304F\u3001\u3053\u308C\u304B\u3089\u3088\u308D\u3057\u304F\u306A\uFF01"
    portrait: {fileID: -3833558156305714257, guid: d0a1416310d325447b2072d177408040, type: 3}
    backgroundOverride: {fileID: 0}
    requestNameInput: 0
  - speaker: '-'
    text: "\u3053\u3046\u3057\u3066\u8A66\u7DF4\u3068\u9858\u3044\u306E\u5854\u3092\u8E0F\u7834\u3057\u305F{name}\u3068\u3001\n\u5143\u5B88\u8B77\u8005\u30D5\u30A7\u30B4\u30FC\u30EB\u306E\u65C5\u304C\u59CB\u307E\u308B\u306E\u3060\u304C\u3001\n\u305D\u308C\u306F\u307E\u305F\u5225\u306E\u304A\u8A71\u3002"
    portrait: {fileID: -3833558156305714257, guid: d0a1416310d325447b2072d177408040, type: 3}
    backgroundOverride: {fileID: 0}
    requestNameInput: 0
  - speaker: "\u30A8\u30DF\u30EA\u30FC"
    text: "\u3054\u4E3B\u4EBA\u69D8\u2026\u2026\u3069\u3046\u3057\u3066\u79C1\u3092\u7F6E\u3044\u3066\u884C\u3063\u305F\u306E\u306B\u3083\u2026\u2026\n\u79C1\u304C\u732B\u3060\u304B\u3089\u306B\u3083\u2026\u2026\uFF1F\n\u79C1\u304C\u4EBA\u9593\u306B\u306A\u308C\u3070\u2026\u2026"
    portrait: {fileID: 21300000, guid: d68da8999fcfcdb4e98ad00ac7a7f9d1, type: 3}
    backgroundOverride: {fileID: 0}
    requestNameInput: 0
  - speaker: '-'
    text: "\u2026\u2026\u8A71\u306E\u6D41\u308C\u3067\u6368\u3066\u3089\u308C\u3066\u3057\u307E\u3063\u305F\u30A8\u30DF\u30EA\u30FC\u304C\u3001\n\u30CD\u30B3\u30DE\u30BF\u306B\u306A\u3063\u3066\u4E3B\u4EBA\u3092\u8FFD\u3046\u306E\u3060\u304C\u3001\u3053\u308C\u3082\u307E\u305F\u5225\u306E\u304A\u8A71\u3002"
    portrait: {fileID: 4242386891756241611, guid: 0c575f39308ec54449d7fd2cac4ed668, type: 3}
    backgroundOverride: {fileID: 0}
    requestNameInput: 0
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u3068\u3044\u3046\u308F\u3051\u3067\u3001\u30B2\u30FC\u30E0\u30AF\u30EA\u30A2\u304A\u3081\u3067\u3068\u3046\uFF01\n\u30AF\u30EA\u30A2\u7279\u5178\u3068\u3057\u3066\u3001\u56F3\u9451\u306F\u554F\u7B54\u7121\u7528\u3067\u5168\u958B\u653E\u3060\uFF01\n\u56F3\u9451\u30B3\u30F3\u30D7\u3057\u3066\u308B\u6687\u304C\u3042\u3063\u305F\u3089\u4F5C\u8005\u306E\u6B21\u56DE\u4F5C\u3092\u5F85\u3064\u304B\u3001\n\u5225\u306E\u30B2\u30FC\u30E0\u3067\u3082\u3084\u3063\u3066\u308D\uFF01"
    portrait: {fileID: -3833558156305714257, guid: d0a1416310d325447b2072d177408040, type: 3}
    backgroundOverride: {fileID: -4246306638102300522, guid: 925099285ac215944b47711942379fbe, type: 3}
    requestNameInput: 0
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u3061\u306A\u307F\u306B\u30AF\u30EA\u30A2\u5F8C\u306E\u3084\u308A\u8FBC\u307F\u8981\u7D20\u306F\u7121\u3044\u305C\u3002\n100\u968E\u306E20STEP\u3088\u308A\u5148\u306B\u306F\u9032\u3081\u306A\u3044\u3057\u3001\n\u5F37\u5316\u3055\u308C\u305F\u79C1\u304C\u51FA\u3066\u6765\u305F\u308A\u3082\u3057\u306A\u3044\u3002\n\u305B\u3044\u305C\u3044\u30B9\u30BF\u30C3\u30D5\u30ED\u30FC\u30EB\u304C\u56F3\u9451\u304B\u3089\u898B\u308C\u308B\u7A0B\u5EA6\u3060\u3002"
