  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u307E\u3041\u3001\u52B9\u679C\u304C\u591A\u3044\u3068\u8A00\u3063\u3066\u3082\u3001\n\u5168\u72B6\u614B\u7570\u5E38\u8010\u6027\u3068\n\u5168\u5C5E\u6027\u8010\u6027\u304C+10\u7A0B\u5EA6\u3060\u3051\u3069\u306A\u3002"
