  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u4ECA\u5F8C\u3082\u305D\u3093\u306A\u611F\u3058\u3067\u52B9\u679C\u304C\u591A\u3059\u304E\u3066\u8AAC\u660E\u653E\u68C4\u3059\u308B\n\u30A2\u30A4\u30C6\u30E0\u304C\u5897\u3048\u3066\u6765\u308B\u304B\u3089\u3001\n\u30B9\u30C6\u30FC\u30BF\u30B9\u3092\u81EA\u5206\u3067\u30C1\u30A7\u30C3\u30AF\u3057\u3066\u304F\u308C\u3088\u306A\uFF01"
