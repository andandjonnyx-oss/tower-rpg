  zukanTitle: "\u7121\u99C4\u306B\u7279\u6B8A\u884C\u52D5\u5C0E\u5165\u3057\u904E\u304E\u305F"
  floor: 98
  step: 2
  backgroundImage: {fileID: 21300000, guid: aef2ec3c256f226419898fc53b2fda28, type: 3}
  lines:
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u98DF\u3044\u8352\u3089\u3057\u3068\u304B\u3001\u30EC\u30D9\u30EB\u30C9\u30EC\u30A4\u30F3\u3068\u304B\u3001\n\u8272\u3005\u7279\u6B8A\u306A\u884C\u52D5\u3092\u4F5C\u3063\u305F\u3051\u308C\u3069\u3001\n\u305D\u308C\u3092\u5B9F\u88C5\u3057\u3066\u308B\u30E2\u30F3\u30B9\u30BF\u30FC\u306F\u6975\u50C5\u304B\u2026\u2026"
    portrait: {fileID: -1474213477433997886, guid: 9a865c02e1edaa349aa9835276d7453f, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u6298\u89D2\u4F5C\u3063\u305F\u30AA\u30EA\u30B8\u30CA\u30EA\u30C6\u30A3\uFF1F\u3042\u308B\u8981\u7D20\u3060\u304B\u3089\u3001\n\u3082\u3063\u3068\u8272\u3093\u306A\u30E2\u30F3\u30B9\u30BF\u30FC\u306B\u4F7F\u308F\u305B\u305F\u3044\u3063\u3066\u6C17\u6301\u3061\u306F\u3042\u308B\u3051\u3069\u3001\n\u305D\u306E\u30E2\u30F3\u30B9\u30BF\u30FC\u306E\u30A4\u30E1\u30FC\u30B8\u3082\u58CA\u3057\u305F\u304F\u306A\u3044\u3057\u306A\u3002"
    portrait: {fileID: -1474213477433997886, guid: 9a865c02e1edaa349aa9835276d7453f, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u7279\u306B\u7D42\u76E4\u306E\u6575\u306F\u795E\u8A71\u751F\u7269\u3060\u3063\u305F\u308A\u5927\u7269\u304C\u591A\u3044\u304B\u3089\u3001\n\u3042\u3093\u307E\u308A\u5909\u306A\u884C\u52D5\u3092\u3055\u305B\u3089\u308C\u306A\u3044\u3093\u3060\u3088\u306A\u2026\u2026"
    portrait: {fileID: -1474213477433997886, guid: 9a865c02e1edaa349aa9835276d7453f, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u4E00\u65B9\u3067\u732B\u7CFB\u306E\u30E2\u30F3\u30B9\u30BF\u30FC\u306F\u884C\u52D5\u304C\u307B\u3068\u3093\u3069\n\u306D\u3053\u3071\u3093\u3061\u3068\u307F\u3060\u308C\u3072\u3063\u304B\u304D\u306B\u306A\u3063\u3066\u3057\u307E\u3063\u305F\u3002\n\u30A8\u30CD\u30DF\u30FC\u8A2D\u8A08\u306F\u96E3\u3057\u3044\u305C\u2026\u2026\n\u6B21\u56DE\u4F5C\u3067\u6539\u5584\u3055\u308C\u308B\u3068\u3044\u3044\u306A\uFF1F"
    portrait: {fileID: -1474213477433997886, guid: 9a865c02e1edaa349aa9835276d7453f, type: 3}
    backgroundOverride: {fileID: 0}
