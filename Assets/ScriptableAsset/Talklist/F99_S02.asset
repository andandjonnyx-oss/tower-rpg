  backgroundImage: {fileID: 0}
  lines:
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u305D\u308C\u3067\u3001\u9858\u3044\u4E8B\u306F\u3069\u3046\u3059\u308B\u3093\u3060\uFF1F"
    portrait: {fileID: -5075695696183938511, guid: 0a890b709db3960428ff418f7aeebe9a, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: You
    text: "\u305D\u3082\u305D\u3082\u3069\u306E\u7A0B\u5EA6\u306E\u9858\u3044\u304C\u53F6\u3048\u3089\u308C\u308B\u306E\u304B\u3082\u308F\u304B\u3093\u306A\u3044\u3057\u306A\u3041\u2026\u2026"
    portrait: {fileID: -5075695696183938511, guid: 0a890b709db3960428ff418f7aeebe9a, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u307E\u3041\u3001\u4ECA\u306E\u6B8B\u3063\u3066\u308B\u9B54\u529B\u3058\u3083\u73FE\u5B9F\u7684\u306B\u306F\u3053\u306E\u5854\u306B\u3042\u308B\u30EC\u30A2\u30A2\u30A4\u30C6\u30E0\u3092\n\u4F55\u70B9\u304B\u5B9F\u4F53\u5316\u3055\u305B\u3066\u6301\u3063\u3066\u3044\u304F\u7A0B\u5EA6\u304B\u306A\u3002\n\u6570\u767E\u5E74\u524D\u306A\u3089\u4E16\u754C\u5F81\u670D\u3082\u5922\u3058\u3083\u7121\u304B\u3063\u305F\u3093\u3060\u3051\u3069\u306A\u3001\n\u751F\u307E\u308C\u308B\u6642\u4EE3\u3092\u9593\u9055\u3048\u305F\u306A\u3001\u304A\u524D\u3002"
    portrait: {fileID: -5075695696183938511, guid: 0a890b709db3960428ff418f7aeebe9a, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u307E\u3001\u6570\u767E\u5E74\u524D\u306E\u96E3\u6613\u5EA6\u3058\u3083\u305D\u3082\u305D\u3082\u3053\u3053\u307E\u3067\u767B\u308C\u306A\u3044\u3060\u308D\u3046\u3051\u3069\u306A\u3002\n\u8EAB\u306E\u4E08\u306B\u5408\u3063\u305F\u30A2\u30A4\u30C6\u30E0\u3092\u6301\u3063\u3066\u884C\u3051\u3088\uFF1F"
    portrait: {fileID: -3833558156305714257, guid: d0a1416310d325447b2072d177408040, type: 3}
    backgroundOverride: {fileID: 0}
