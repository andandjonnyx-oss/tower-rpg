  backgroundImage: {fileID: -5642793763813460095, guid: d227693ff385d6b42b19c6ffd3512034, type: 3}
  lines:
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u6700\u5F8C\u306E\u5F37\u6575\u30BE\u30FC\u30F3\uFF01\n\u30E9\u30B9\u30DC\u30B9\u3092\u5012\u3059\u306B\u306F\u3001\u3053\u306E\u8FBA\u306E\u6575\u3092\u8EFD\u304F\u637B\u308B\u304F\u3089\u3044\u306B\u306F\n\u5F37\u304F\u306A\u3063\u3066\u304A\u304D\u305F\u3044\u306A\u3002"
    portrait: {fileID: -5075695696183938511, guid: 0a890b709db3960428ff418f7aeebe9a, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u307E\u305A\u306F\u71BE\u5929\u4F7F\uFF01\u3000\u30A2\u30FC\u30AF\u30A8\u30F3\u30B8\u30A7\u30EB\u3088\u308A7\u968E\u7D1A\u4E0A\uFF01\n\u5F37\u529B\u306A\u8056\u3068\u708E\u306E\u4F7F\u3044\u624B\u3060\uFF01"
    portrait: {fileID: -5075695696183938511, guid: 0a890b709db3960428ff418f7aeebe9a, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u6B21\u306B\u30AF\u30C8\u30A5\u30EB\u30D5\uFF01\u3000\u90AA\u795E\u30AA\u30D6\u90AA\u795E\uFF01\n\u672C\u4EBA\u306F\u30BF\u30B3\u3058\u3083\u306A\u3044\u3063\u3066\u8A00\u3063\u3066\u308B\u3051\u3069\u3001\n\u6C37\u5C5E\u6027\u653B\u6483\u4F7F\u3046\u3057\u306A\u3041\u2026\u2026"
    portrait: {fileID: -5075695696183938511, guid: 0a890b709db3960428ff418f7aeebe9a, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u6700\u5F8C\u306B\u30D2\u30D2\u30A4\u30ED\u30B9\u30E9\u30A4\u30E0\uFF01\n\u3064\u3044\u306B\u30EC\u30A2\u67A0\u3058\u3083\u306A\u304F\u306A\u3063\u305F\u7A3C\u304E\u30E2\u30F3\u30B9\u30BF\u30FC\uFF01\n\u4F1A\u5FC3\u306E\u4E00\u6483\u3092\u53E9\u304D\u3053\u3081\uFF01"
    portrait: {fileID: -5075695696183938511, guid: 0a890b709db3960428ff418f7aeebe9a, type: 3}
