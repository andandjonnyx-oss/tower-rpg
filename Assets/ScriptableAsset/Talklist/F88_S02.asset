  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u307E\u3041\u305D\u308C\u4EE5\u524D\u306B\u3053\u306E\u30B2\u30FC\u30E0\u305D\u3093\u306A\u306B\u30DC\u30EA\u30E5\u30FC\u30E0\u7121\u3044\u3057\u3002\n\u304C\u3063\u3064\u308A\u3084\u308B\u30BF\u30A4\u30D7\u306E\u4EBA\u9593\u306A\u30891\u65E5\u3067\u30AF\u30EA\u30A2\u3060\u308D\u3046\u306A\u3002"
