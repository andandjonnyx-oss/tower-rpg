  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u305F\u3060\u3057\u3001\u3053\u3053\u3067\u306E\u597D\u611F\u5EA6\u3068\u306F\u3001\u304A\u524D\u306E\u79C1\u306B\u5BFE\u3059\u308B\u597D\u611F\u5EA6\u3060\u304B\u3089\u3001\n\u4E0A\u3052\u3059\u304E\u308B\u3068\u5F37\u5236\u7684\u306B\u9B45\u4E86\u3055\u308C\u305F\u308A\u4E0D\u5229\u306B\u306A\u308B\u305C\uFF01"
