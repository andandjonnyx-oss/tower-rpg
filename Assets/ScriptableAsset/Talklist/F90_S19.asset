  id: F90_S19
  zukanTitle: "\u3044\u3088\u3044\u3088\u30BB\u30DF\u30E9\u30B9\u30DC\u30B9\uFF01"
  floor: 90
  step: 19
  backgroundImage: {fileID: 0}
  lines:
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u30BB\u30DF\u30E9\u30B9\u30DC\u30B9\u3063\u3066\u8A00\u3044\u65B9\u306F\u304A\u304B\u3057\u3044\u306A\u2026\u2026\n\u53F3\u8155\u3001\u3063\u3066\u8A00\u3046\u3079\u304D\u304B\uFF1F\n\u3067\u308299\u968E\u306E\u6575\u306E\u65B9\u304C\u5384\u4ECB\u3060\u3063\u305F\u308A\u3059\u308B\u3088\u306A\u2026\u2026"
    portrait: {fileID: -5075695696183938511, guid: 0a890b709db3960428ff418f7aeebe9a, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u307E\u3041\u3068\u3082\u304B\u304F\u300190\u968E\u306E\u30DC\u30B9\u306F\u30C0\u30CF\u30FC\u30AB\u3060\u3002\n\u307E\u3041\u307E\u3041\u805E\u3044\u305F\u3053\u3068\u3042\u308B\u3060\u308D\u3001\n\u306A\u3093\u304B\u60AA\u305D\u3046\u306A\u30C9\u30E9\u30B4\u30F3\u3060\u3002"
    portrait: {fileID: -5075695696183938511, guid: 0a890b709db3960428ff418f7aeebe9a, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u304A\u524D\u306B\u306F\u3057\u3063\u304B\u308A\u52DD\u3063\u3066\u6B32\u3057\u3044\u304B\u3089\u306A\u3002\n\u304D\u3061\u3093\u3068\u30A2\u30C9\u30D0\u30A4\u30B9\u3059\u308B\u305C\u3002\u3042\u3044\u3064\u306F\u708E\u3068\u95C7\u3092\u4F7F\u3046\u3002\n\u305D\u3057\u3066\u982D\u304C3\u3064\u3042\u308B\u304B\u30893\u56DE\u884C\u52D5\u3060\u3002"
    portrait: {fileID: -5075695696183938511, guid: 0a890b709db3960428ff418f7aeebe9a, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u305D\u3057\u3066\u5012\u3059\u3068\u7B2C\u4E8C\u5F62\u614B\u3068\u3057\u3066\u3001\u300E\u30A2\u30B8\u30FB\u30C0\u30CF\u30FC\u30AB\u300F\u306B\u306A\u308B\u3002\n\u3069\u3063\u3061\u306E\u5F62\u614B\u3082\u4E71\u6570\u95BE\u502490\uFF5E100\u3067\u30AA\u30FC\u30EB\u30D0\u30C3\u30C9\u3092\u4F7F\u3046\u304B\u3089\u3001\n\u305B\u3081\u3066\u534A\u5206\u306ELUC\u306F\u78BA\u4FDD\u3057\u3066\u304A\u304B\u306A\u3044\u3068\u72B6\u614B\u7570\u5E38\u5730\u7344\u3060\u305C\u3002"
    portrait: {fileID: -5075695696183938511, guid: 0a890b709db3960428ff418f7aeebe9a, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u307B\u3089\u3088\u3001\u79C1\u304C\u5FC3\u3092\u8FBC\u3081\u3066\u4F5C\u3063\u305F\u304A\u5B88\u308A\u3060\u3002\n\u3061\u3083\u3093\u3068\u6D3B\u7528\u3057\u308D\u3088\uFF1F"
    portrait: {fileID: -3833558156305714257, guid: d0a1416310d325447b2072d177408040, type: 3}
    backgroundOverride: {fileID: 0}
