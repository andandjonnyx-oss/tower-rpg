  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u7D9A\u3044\u3066\u30C0\u30D6\u30EB\u30B5\u30F3\u30C0\u30FC\u30C9\u30E9\u30B4\u30F3\u3002\n\u96F7\u8010\u6027\u5927\u5E45\u30A2\u30C3\u30D7\u306E\u30A2\u30A4\u30C6\u30E0\u304C\u3042\u308C\u3070\u306A\u30FC\u3001\n\u305D\u3093\u306A\u90FD\u5408\u306E\u3044\u3044\u30A2\u30A4\u30C6\u30E0\u3001\u30A4\u30D9\u30F3\u30C8\u3067\u624B\u306B\u5165\u3063\u305F\u308A\u3057\u306A\u3044\u304B\u30FC\u3002"
