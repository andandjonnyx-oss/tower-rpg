  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u6700\u5F8C\u306F1\u304B\u3089500\u30C0\u30E1\u30FC\u30B8\u304F\u3093\uFF08\u9632\u5FA1\u8CAB\u901A\uFF09\u3060\u3002\n\uFF08\uFF09\u3064\u3051\u3066\u307E\u3067\u9632\u5FA1\u8CAB\u901A\u3092\u4F1D\u3048\u305F\u304B\u3063\u305F\u306E\u304B\u306D\u2026\u2026"
