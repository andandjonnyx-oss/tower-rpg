    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u725B\u3092\u596A\u3044\u306B\u6765\u305F\u30D8\u30E9\u30AF\u30EC\u30B9\u3068\u6226\u3063\u3066\u8CA0\u3051\u3066\u3057\u307E\u3046\u3093\u3060\u3002\n\u30D8\u30E9\u30AF\u30EC\u30B9\u3068\u8A00\u3048\u3070\u82F1\u96C4\u3060\u304C\u3001\n\u3088\u304F\u3088\u304F\u8ABF\u3079\u308B\u3068\u30ED\u30AF\u306A\u3053\u3068\u3057\u3066\u306D\u30FC\u305C\uFF01"
    portrait: {fileID: -8468336318900812975, guid: a71047c7cdbc5ef48950b42866cc45b3, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u307E\u3041\u79C1\u306B\u8A00\u308F\u305B\u308C\u3070\u3001\u795E\u8A71\u306A\u3093\u3066\u306E\u306F\u6226\u4E89\u306B\u52DD\u3063\u305F\u4EBA\u9593\u304C\n\u81EA\u5206\u9054\u3092\u6B63\u5F53\u5316\u3059\u308B\u305F\u3081\u306B\u4F5C\u3063\u305F\u5E7B\u60F3\u306A\u3093\u3060\u3051\u3069\u306A\u3002\n\u305D\u3093\u306A\u5E7B\u60F3\u3092\u53C2\u8003\u306B\u30E2\u30F3\u30B9\u30BF\u30FC\u3092\u751F\u307F\u51FA\u3059\u79C1\u306F\u4E00\u4F53\u4F55\u306A\u3093\u3060\u2026\u2026\uFF1F"
