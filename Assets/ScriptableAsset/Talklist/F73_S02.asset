  lines:
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u30AA\u30EB\u30C8\u30ED\u30B9\u306F\u30B1\u30EB\u30D9\u30ED\u30B9\u306E\u5F1F\u3068\u3055\u308C\u3066\u3044\u308B\u306A\u3002\n\u307E\u3041\u3042\u306E\u8FBA\u5927\u91CF\u306B\u5144\u5F1F\u3044\u308B\u3093\u3060\u3051\u3069\u306A\u3002"
