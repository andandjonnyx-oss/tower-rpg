  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "81\u968E\uFF5E90\u968E\u306F\u7570\u5909\u304C\u3042\u3063\u305F\u3089\u623B\u308B\u3001\n\u3082\u3057\u304F\u306F20STEP\u3067\u7570\u5909\u304C\u3042\u3063\u305F\u304B\u3069\u3046\u304B\u3092\u9078\u629E\u3055\u305B\u3066\u3001\n\u9593\u9055\u3063\u3066\u305F\u3089\u968E\u5C64\u30EB\u30FC\u30D7\u3002"
