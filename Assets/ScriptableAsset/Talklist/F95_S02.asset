  backgroundImage: {fileID: -5642793763813460095, guid: d227693ff385d6b42b19c6ffd3512034, type: 3}
  lines:
  - speaker: You
    text: "\u3053\u306E\u5854\u3092\u653B\u7565\u3057\u305F\u3089\u3001\u304A\u524D\u306F\u3069\u3046\u306A\u308B\u3093\u3060\uFF1F"
    portrait: {fileID: -5075695696183938511, guid: 0a890b709db3960428ff418f7aeebe9a, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u5206\u304B\u308A\u5207\u3063\u305F\u4E8B\u3092\u805E\u304F\u306A\u3088\u3002\u6D88\u3048\u308B\u306B\u6C7A\u307E\u3063\u3066\u308B\u3060\u308D\u3002\n\u305D\u3057\u3066\u5B88\u8B77\u8005\u304C\u6D88\u3048\u3001\u9858\u3044\u3092\u53F6\u3048\u3066\u9B54\u529B\u304C\u5207\u308C\u308B\u3053\u3068\u3067\u3001\n\u3053\u306E\u5854\u3082\u6D88\u3048\u308B\u3002\n\u3042\u3042\u3001\u4ED6\u306E\u5854\u304C\u898B\u3064\u304B\u3089\u306A\u3044\u306E\u306F\u3001\u3082\u3046\u653B\u7565\u3055\u308C\u305F\u304B\u3089\u304B\u3082\u306A\uFF1F"
    portrait: {fileID: -5075695696183938511, guid: 0a890b709db3960428ff418f7aeebe9a, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: You
    text: "\u2026\u2026"
    portrait: {fileID: -5075695696183938511, guid: 0a890b709db3960428ff418f7aeebe9a, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u304A\u3044\u304A\u3044\u3001\u81EA\u5206\u304B\u3089\u8A71\u632F\u3063\u3068\u3044\u3066\u4F55\u6C17\u307E\u305A\u304F\u306A\u3063\u3066\u3093\u3060\u3002\n\u304A\u524D\u3089\u4EBA\u9593\u3068\u306F\u4FA1\u5024\u89B3\u304C\u9055\u3046\u3093\u3060\u3088\u3001\n\u5F79\u76EE\u3092\u5168\u3046\u3059\u308B\u305F\u3081\u306B\u3053\u3061\u3068\u3089\u751F\u304D\u3066\u3093\u3060\u3002"
    portrait: {fileID: -8468336318900812975, guid: a71047c7cdbc5ef48950b42866cc45b3, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u79C1\u306F\u3068\u3063\u304F\u306B\u899A\u609F\u3092\u6C7A\u3081\u305F\u3093\u3060\u3002\n\u79C1\u306F\u6B62\u307E\u3089\u306D\u3048\u304B\u3089\u3088\u3001\n\u304A\u524D\u3082\u6B62\u307E\u308B\u3093\u3058\u3083\u306D\u3048\u305E\u2026\u2026"
    portrait: {fileID: -3833558156305714257, guid: d0a1416310d325447b2072d177408040, type: 3}
    backgroundOverride: {fileID: 0}
