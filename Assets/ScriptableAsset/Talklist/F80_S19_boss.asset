  lines:
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "80\u968E\u306E\u30DC\u30B9\u306F\u3001\u5E30\u3063\u3066\u304D\u307E\u3057\u305F\uFF01\n\u30AF\u30A4\u30BA\u306E\u30DF\u30CB\u30B2\u30FC\u30E0\u3060\u305C\uFF01"
    portrait: {fileID: -3833558156305714257, guid: d0a1416310d325447b2072d177408040, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u4ECA\u56DE\u306E\u30CE\u30EB\u30DE\u306F\u306A\u3093\u3068\u7D0430\u554F\uFF01\n\u51FA\u984C\u7BC4\u56F2\u3082\u5E83\u304F\u306A\u3063\u305F\u4E0A\u306B\u3001\n\u4E00\u822C\u5E38\u8B58\u3060\u3063\u305F\u308A\u3082\u51FA\u3066\u6765\u308B\u305C\uFF01\n\u30E9\u30A4\u30D5\u30825\u56DE\u306B\u5897\u3084\u3057\u3066\u3084\u3063\u305F\u3051\u3069\u306A\u3002"
    portrait: {fileID: -3833558156305714257, guid: d0a1416310d325447b2072d177408040, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u306A\u3093\u3067\u7D0430\u554F\u306A\u306E\u304B\u3063\u3066\uFF1F\n\u305D\u308A\u3083\u3042\u3001\u304A\u524D\u2026\u2026\u8A00\u308F\u305B\u3093\u306A\u3088\u3002"
