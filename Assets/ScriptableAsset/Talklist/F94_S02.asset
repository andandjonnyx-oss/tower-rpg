  id: F94_S02
  zukanTitle: "\u3053\u308C\u305E\u672C\u5F53\u306E\u591A\u982D\u98FC\u3044"
  floor: 94
  step: 2
  backgroundImage: {fileID: 0}
  lines:
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u6700\u5F8C\u306E\u4E2D\u6575\u30BE\u30FC\u30F3\u306F\u3001\u7D42\u76E4\u3042\u308B\u3042\u308B\u3001\n\u591A\u982D\u3060\u304B\u3089\u884C\u52D5\u56DE\u6570\u305F\u304F\u3055\u3093\u3042\u308B\u3088\u30BE\u30FC\u30F3\uFF01"
    portrait: {fileID: -5075695696183938511, guid: 0a890b709db3960428ff418f7aeebe9a, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u307E\u305A\u306F\u30B1\u30EB\u30D9\u30ED\u30B9\u3002\u304A\u99B4\u67D3\u307F\u306E\u308F\u3093\u3061\u3083\u3093\u3060\u306A\u3002\n\u706B\u8010\u6027\u3068\u95C7\u8010\u6027\u304C\u3042\u308C\u3070\u305D\u3053\u307E\u3067\u82E6\u6226\u3057\u306A\u3044\u3060\u308D\u3046\u3088\u3002\n\u3055\u3063\u304D\u8CB0\u3063\u305F\u304A\u5B88\u308A\u304C\u5F79\u306B\u7ACB\u3064\u3060\u308D\u3046\u306A\u3002"
    portrait: {fileID: -5075695696183938511, guid: 0a890b709db3960428ff418f7aeebe9a, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u6B21\u306B\u7A76\u6975\u306E\u96F7\u9F8D\u3002\n\u672C\u5BB6\u3082\u4ECA\u306F\u8D85\u96F7\u9F8D\u3063\u3066\u306E\u304C\u51FA\u3066\u308B\u3093\u3060\u306A\u3002\n\u307E\u3041\u96F7\u8010\u6027\u304C\u3042\u308C\u3070\u4F59\u88D5\u3060\u304B\u3089\u3001\u907F\u96F7\u91DD\u6301\u3063\u3068\u3051\u3070\u3044\u3044\u3088\u306A\u3002"
    portrait: {fileID: -5075695696183938511, guid: 0a890b709db3960428ff418f7aeebe9a, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u6700\u5F8C\u306B\u306B\u3083\u307E\u305F\u306E\u304A\u308D\u3061\u3002\n8\u56DE\u884C\u52D5\u306E\u4EE3\u511F\u3068\u3057\u3066\u653B\u6483\u529B\u304C\u4F4E\u3044\u304B\u3089\u3001\n\u307F\u3060\u308C\u3072\u3063\u304B\u304D\u306A\u3093\u3066\u307B\u307C\u30C0\u30E1\u30FC\u30B8\u7121\u3044\u3060\u308D\u3046\u306A\u3002"
    portrait: {fileID: -5075695696183938511, guid: 0a890b709db3960428ff418f7aeebe9a, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u2026\u2026\u7D42\u76E4\u306A\u306E\u306B\u7C21\u5358\u306B\u5B8C\u5C01\u51FA\u6765\u308B\u6575\u3060\u3089\u3051\u3058\u3083\u306D\u30FC\u304B\uFF01"
    portrait: {fileID: -6269266055418861456, guid: 50b50e7433fb4b940a7c93223d3f9f5d, type: 3}
    backgroundOverride: {fileID: 0}
