  backgroundImage: {fileID: -5642793763813460095, guid: d227693ff385d6b42b19c6ffd3512034, type: 3}
  lines:
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u30D0\u30D5\u3068\u30C7\u30D0\u30D5\u306F\u5171\u5B58\u3057\u306A\u3044\u3002\n\u4E0A\u66F8\u304D\u3055\u308C\u308B\u4ED5\u69D8\u3060\u304B\u3089\u3001\n\u5C0F\u3055\u3044\u30D0\u30D5\u3067\u3082\u5927\u304D\u306A\u30C7\u30D0\u30D5\u3092\u6253\u3061\u6D88\u305B\u308B\u3002"
    portrait: {fileID: -5075695696183938511, guid: 0a890b709db3960428ff418f7aeebe9a, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u3060\u304B\u3089MP\u304C\u305D\u308C\u306A\u308A\u306B\u3042\u308B\u4ECA\u306A\u3089\u3001\n\u30C7\u30D0\u30D5\u89E3\u9664\u306E\u305F\u3081\u306B\u30AA\u30FC\u30EB\u30A2\u30C3\u30D7\u3092\u30AC\u30F3\u30AC\u30F3\u4F7F\u3046\u3079\u304D\u3060\u306A\u3002"
    portrait: {fileID: -5075695696183938511, guid: 0a890b709db3960428ff418f7aeebe9a, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u307E\u3041\u3001\u76F8\u624B\u306B\u30C7\u30D0\u30D5\u3092\u304B\u3051\u308B\u6642\u306F\u30C7\u30D0\u30D5\u8010\u6027\u304C\u8003\u616E\u3055\u308C\u308B\u304B\u3089\u3001\n\u7D20\u76F4\u306B\u30A2\u30F3\u30D0\u30D5\u3084\u30C7\u30A3\u30B9\u30DA\u30EB\u3092\u4F7F\u3046\u3079\u304D\u304B\u3082\u306A\u3002"
    portrait: {fileID: -5075695696183938511, guid: 0a890b709db3960428ff418f7aeebe9a, type: 3}
    backgroundOverride: {fileID: 0}
  - speaker: "\u30D5\u30A7\u30B4\u30FC\u30EB"
    text: "\u3061\u306A\u307F\u306B\u79C1\u306E\u7B2C\u4E8C\u5F62\u614B\u306F\u30AA\u30FC\u30EB\u30A2\u30C3\u30D7\u3068\u30AA\u30FC\u30EB\u30C0\u30A6\u30F3\u3092\n\u540C\u6642\u306B\u4F7F\u3046\u9B54\u6CD5\u3092\u6301\u3063\u3066\u308B\u304B\u3089\u306A\u3002\n\u30C7\u30A3\u30B9\u30DA\u30EB\u306F\u6301\u3063\u3066\u304A\u3044\u305F\u65B9\u304C\u3044\u3044\u305C\uFF01"
